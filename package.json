{
  "name": "docs-backport-action",
  "version": "1.0.0",
  "description": "GitHub Action to backport documentation changes between folders in Docusaurus projects",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write **/*.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "github",
    "actions",
    "backport",
    "docusaurus"
  ],
  "author": "loft-sh",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^9.1.1",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^7.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  }
}
